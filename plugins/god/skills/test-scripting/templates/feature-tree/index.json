{
  "version": "2026-04-28",
  "pageAbbreviations": {
    "PRQD": "请购单详情页",
    "PRQE": "请购单编辑页",
    "PRQL": "请购单列表页"
  },
  "pages": {
    "PRQD": {
      "name": "请购单详情页",
      "route": "/purchase-requisitions/:id",
      "file": "PRQD.md",
      "groups": {
        "PRQD-INFO": {
          "name": "基本信息展示",
          "features": [
            "PRQD-INFO-BASE",
            "PRQD-INFO-LINE",
            "PRQD-INFO-ATCH"
          ]
        },
        "PRQD-APVL": {
          "name": "审批操作",
          "features": [
            "PRQD-APVL-APV",
            "PRQD-APVL-REJ",
            "PRQD-APVL-LOG"
          ]
        },
        "PRQD-ACT": {
          "name": "详情页操作",
          "features": [
            "PRQD-ACT-EDIT",
            "PRQD-ACT-CLOS",
            "PRQD-ACT-PRNT",
            "PRQD-ACT-EXPT"
          ]
        }
      }
    },
    "PRQE": {
      "name": "请购单编辑页",
      "route": "/purchase-requisitions/create | /purchase-requisitions/:id/edit",
      "file": "PRQE.md",
      "groups": {
        "PRQE-BASE": {
          "name": "基本信息",
          "features": [
            "PRQE-BASE-FILL",
            "PRQE-BASE-DEPT",
            "PRQE-BASE-DATE"
          ]
        },
        "PRQE-LINE": {
          "name": "物料明细",
          "features": [
            "PRQE-LINE-ADD",
            "PRQE-LINE-SEL",
            "PRQE-LINE-QTY",
            "PRQE-LINE-PRC",
            "PRQE-LINE-EDIT",
            "PRQE-LINE-DEL",
            "PRQE-LINE-SORT"
          ]
        },
        "PRQE-CALC": {
          "name": "金额计算",
          "features": [
            "PRQE-CALC-ROW",
            "PRQE-CALC-TOT"
          ]
        },
        "PRQE-ATCH": {
          "name": "附件管理",
          "features": [
            "PRQE-ATCH-UP",
            "PRQE-ATCH-DEL"
          ]
        },
        "PRQE-SAVE": {
          "name": "保存操作",
          "features": [
            "PRQE-SAVE-DFT",
            "PRQE-SAVE-VLD"
          ]
        },
        "PRQE-ACT": {
          "name": "提交操作",
          "features": [
            "PRQE-ACT-SUB",
            "PRQE-ACT-CANC"
          ]
        }
      }
    },
    "PRQL": {
      "name": "请购单列表页",
      "route": "/purchase-requisitions",
      "file": "PRQL.md",
      "groups": {
        "PRQL-FLTR": {
          "name": "筛选与搜索",
          "features": [
            "PRQL-FLTR-KW",
            "PRQL-FLTR-STAT",
            "PRQL-FLTR-DATE",
            "PRQL-FLTR-DEPT",
            "PRQL-FLTR-RST"
          ]
        },
        "PRQL-ACT": {
          "name": "列表操作",
          "features": [
            "PRQL-ACT-ADD",
            "PRQL-ACT-VIEW",
            "PRQL-ACT-EDIT",
            "PRQL-ACT-DEL",
            "PRQL-ACT-COPY"
          ]
        },
        "PRQL-BTCH": {
          "name": "批量操作",
          "features": [
            "PRQL-BTCH-SUB",
            "PRQL-BTCH-DEL"
          ]
        },
        "PRQL-PAGE": {
          "name": "分页",
          "features": [
            "PRQL-PAGE-NEXT",
            "PRQL-PAGE-SIZE"
          ]
        },
        "PRQL-FLOW": {
          "name": "入口",
          "features": []
        }
      }
    }
  },
  "flows": {
    "F-PRQNEW": {
      "name": "新建并提交请购单流程",
      "entryPage": "PRQL",
      "steps": [
        "PRQL-ACT-ADD",
        "PRQE-BASE-FILL",
        "PRQE-LINE-ADD",
        "PRQE-SAVE-DFT",
        "PRQE-ACT-SUB"
      ],
      "crossPages": [
        "PRQL",
        "PRQE"
      ]
    },
    "F-PRQAPV": {
      "name": "请购单审批流程",
      "entryPage": "PRQL",
      "steps": [
        "PRQL-ACT-VIEW",
        "PRQD-APVL-APV"
      ],
      "crossPages": [
        "PRQL",
        "PRQD"
      ]
    },
    "F-PRQREJ": {
      "name": "请购单驳回后重新提交流程",
      "entryPage": "PRQL",
      "steps": [
        "PRQL-ACT-EDIT",
        "PRQE-LINE-EDIT",
        "PRQE-ACT-SUB"
      ],
      "crossPages": [
        "PRQL",
        "PRQE"
      ]
    }
  },
